{
  "rules": {
    "users": {
      "description": "User profiles for candidates, employers, and admin accounts",
      "fields": {
        "id": "string",
        "email": "string",
        "fullName": "string",
        "firstName": "string (optional)",
        "lastName": "string (optional)",
        "role": "string (candidate | business | admin)",
        "phone": "string",
        "companyId": "string (optional)",
        "companyName": "string (optional)",
        "companyDescription": "string (optional)",
        "status": "string (active | suspended | pending)",
        "emailVerified": "boolean",
        "createdAt": "string",
        "lastLoginAt": "string",
        "avatarUrl": "string (optional)"
      }
    },
    "companies": {
      "description": "Registered company profiles and verification statuses",
      "fields": {
        "id": "string",
        "name": "string",
        "logo": "string",
        "email": "string",
        "phone": "string",
        "website": "string (optional)",
        "industry": "string",
        "size": "string (optional)",
        "description": "string",
        "location": "string",
        "address": "string (optional)",
        "contactPerson": "string (optional)",
        "contactPosition": "string (optional)",
        "verified": "boolean",
        "verificationStatus": "string (pending | verified | rejected | suspended)",
        "createdBy": "string (user uid)",
        "createdAt": "string",
        "updatedAt": "string"
      }
    },
    "candidateProfiles": {
      "description": "Detailed candidate resumes, education, skills, and portfolio",
      "fields": {
        "id": "string (user uid)",
        "userId": "string",
        "fullName": "string",
        "professionalTitle": "string",
        "profilePhoto": "string (optional)",
        "about": "string",
        "phone": "string",
        "email": "string",
        "location": "string",
        "skills": "array",
        "languages": "array",
        "education": "array",
        "workExperience": "array",
        "certifications": "array",
        "expectedSalary": "number (optional)",
        "preferredEmploymentType": "string (optional)",
        "preferredLocation": "string (optional)",
        "cvUrl": "string (optional)",
        "cvFileName": "string (optional)",
        "profileVisibility": "string (public | private)",
        "createdAt": "string",
        "updatedAt": "string"
      }
    },
    "jobs": {
      "description": "Recruitment vacancies published by verified companies",
      "fields": {
        "id": "string",
        "title": "string",
        "department": "string (optional)",
        "category": "string",
        "companyId": "string",
        "companyName": "string",
        "companyLogo": "string",
        "companyVerified": "boolean",
        "city": "string",
        "location": "string",
        "workplaceType": "string (remote | hybrid | on-site)",
        "employmentType": "string",
        "experienceLevel": "string",
        "education": "string (optional)",
        "minSalary": "number (optional)",
        "maxSalary": "number (optional)",
        "currency": "string",
        "hideSalary": "boolean",
        "skills": "array",
        "description": "string",
        "responsibilities": "array",
        "requirements": "array",
        "benefits": "array",
        "deadline": "string",
        "postedDate": "string",
        "status": "string (draft | pending_review | published | rejected | paused | closed)",
        "isApproved": "boolean",
        "isFeatured": "boolean",
        "viewsCount": "number",
        "applicantsCount": "number",
        "contactPhone": "string (optional)",
        "contactWhatsapp": "string (optional)",
        "isBlueCollarFriendly": "boolean (optional)",
        "createdBy": "string (employer user uid)",
        "createdAt": "string",
        "updatedAt": "string"
      }
    },
    "applications": {
      "description": "Real candidate applications to published jobs",
      "fields": {
        "id": "string",
        "jobId": "string",
        "vacancyId": "string",
        "vacancyTitle": "string",
        "companyId": "string",
        "companyName": "string",
        "companyLogo": "string (optional)",
        "candidateId": "string (user uid)",
        "candidateName": "string",
        "candidateEmail": "string",
        "candidatePhone": "string",
        "candidatePhoto": "string (optional)",
        "appliedDate": "string",
        "status": "string (Müraciət edildi | Baxılır | Qısa Siyahı | Müsahibə | Təklif Göndərildi | Qəbul Edildi | İmtina)",
        "coverNote": "string (optional)",
        "cvUrl": "string (optional)",
        "cvData": "object (optional)",
        "matchScore": "number (optional)",
        "recruiterNotes": "string (optional)",
        "createdAt": "string",
        "updatedAt": "string"
      }
    },
    "subscriptions": {
      "description": "Active and historic subscription plans for employers and candidates",
      "fields": {
        "id": "string",
        "userId": "string",
        "userEmail": "string",
        "userName": "string",
        "role": "string (candidate | business)",
        "planId": "string",
        "tier": "string (FREE | PRO | BUSINESS | PREMIUM)",
        "status": "string (ACTIVE | CANCELLED | EXPIRED)",
        "billingCycle": "string (monthly | yearly)",
        "startDate": "string",
        "endDate": "string",
        "amount": "number",
        "currency": "string",
        "paymentProvider": "string",
        "paymentId": "string",
        "autoRenew": "boolean",
        "createdAt": "string",
        "updatedAt": "string"
      }
    },
    "payments": {
      "description": "Financial transactions and receipts for subscription purchases",
      "fields": {
        "id": "string",
        "userId": "string",
        "userEmail": "string",
        "userName": "string",
        "subscriptionId": "string",
        "planName": "string",
        "amount": "number",
        "currency": "string",
        "status": "string (SUCCESS | FAILED | PENDING | REFUNDED)",
        "paymentMethod": "string",
        "cardLast4": "string (optional)",
        "transactionDate": "string",
        "createdAt": "string"
      }
    },
    "invoices": {
      "description": "Formal billing invoices generated for business and candidate subscriptions",
      "fields": {
        "id": "string",
        "invoiceNumber": "string",
        "userId": "string",
        "companyName": "string (optional)",
        "userEmail": "string",
        "amount": "number",
        "currency": "string",
        "planName": "string",
        "billingCycle": "string",
        "issueDate": "string",
        "dueDate": "string",
        "status": "string (PAID | VOID | UNPAID)",
        "paymentMethod": "string",
        "createdAt": "string"
      }
    },
    "savedJobs": {
      "description": "Candidate bookmarked vacancies",
      "fields": {
        "id": "string",
        "userId": "string",
        "jobId": "string",
        "savedAt": "string"
      }
    },
    "notifications": {
      "description": "Real-time user notifications for status changes, offers and applications",
      "fields": {
        "id": "string",
        "userId": "string",
        "title": "string",
        "message": "string",
        "type": "string (application_submitted | status_changed | interview_invite | job_offer | company_verification | vacancy_approval | new_applicant | payment_success)",
        "isRead": "boolean",
        "link": "string (optional)",
        "data": "object (optional)",
        "createdAt": "string"
      }
    },
    "jobOffers": {
      "description": "Official job offers made from employers to candidates",
      "fields": {
        "id": "string",
        "jobId": "string (optional)",
        "candidateId": "string",
        "candidateName": "string",
        "candidateEmail": "string",
        "candidatePhone": "string (optional)",
        "companyId": "string",
        "companyName": "string",
        "companyLogo": "string (optional)",
        "companyAddress": "string (optional)",
        "companyEmail": "string (optional)",
        "companyPhone": "string (optional)",
        "hrContactPerson": "string (optional)",
        "hrContactPosition": "string (optional)",
        "position": "string",
        "department": "string (optional)",
        "employmentType": "string",
        "workLocation": "string",
        "startDate": "string",
        "grossSalary": "number",
        "netSalary": "number",
        "probationPeriod": "string (optional)",
        "workingSchedule": "string (optional)",
        "annualLeave": "string (optional)",
        "bonus": "string (optional)",
        "benefits": "array",
        "additionalTerms": "string (optional)",
        "templateId": "string (optional)",
        "language": "string (az | en)",
        "status": "string (DRAFT | SENT | ACCEPTED | DECLINED | EXPIRED)",
        "secureToken": "string",
        "acceptedAt": "string (optional)",
        "declinedAt": "string (optional)",
        "declineReason": "object (optional)",
        "createdBy": "string (employer user uid)",
        "createdAt": "string",
        "updatedAt": "string"
      }
    },
    "adminLogs": {
      "description": "Audit trails for moderation, system security and administrative actions",
      "fields": {
        "id": "string",
        "adminId": "string",
        "adminEmail": "string",
        "action": "string",
        "targetType": "string (user | vacancy | company | subscription | payment | setting)",
        "targetId": "string",
        "details": "string",
        "timestamp": "string",
        "ipAddress": "string (optional)"
      }
    },
    "platformSettings": {
      "description": "Global system configurations, commission rates, banner notices, and maintenance status",
      "fields": {
        "id": "string",
        "maintenanceMode": "boolean",
        "allowNewRegistrations": "boolean",
        "requireEmailVerification": "boolean",
        "featuredJobPrice": "number",
        "supportEmail": "string",
        "supportPhone": "string",
        "currency": "string",
        "updatedAt": "string",
        "updatedBy": "string"
      }
    }
  }
}
