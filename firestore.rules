rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return (
        request.auth != null && (
          request.auth.token.role == 'admin' ||
          request.auth.token.email == 'qadiryaqublu@gmail.com' ||
          request.auth.token.email == 'admin@jobia.az' ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
        )
      );
    }

    // Users Collection (Allow read for public recruiter search & admin panel)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Companies Collection
    match /companies/{companyId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Candidate Profiles
    match /candidateProfiles/{profileId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Jobs Collection
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Applications Collection
    match /applications/{applicationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Subscriptions Collection
    match /subscriptions/{subscriptionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Invoices Collection
    match /invoices/{invoiceId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Saved Jobs Collection
    match /savedJobs/{savedJobId} {
      allow read: if true;
      allow create, delete: if true;
      allow update: if true;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Job Offers Collection
    match /jobOffers/{offerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Admin / Audit Logs
    match /adminLogs/{logId} {
      allow read, write: if true;
    }

    // Platform Settings
    match /platformSettings/{settingId} {
      allow read, write: if true;
    }
  }
}

